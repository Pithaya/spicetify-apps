{
    "name": "better-local-files",
    "version": "2.0.11",
    "private": true,
    "scripts": {
        "init": "npm run build && npm run apply",
        "build": "npm run generate-css && spicetify-creator",
        "build-local": "npm run generate-css && spicetify-creator --out=dist --minify",
        "watch": "spicetify-creator --watch",
        "launch-watch": "spicetify watch -a",
        "apply": "spicetify config custom_apps better-local-files && spicetify apply",
        "unapply": "spicetify config custom_apps better-local-files- && spicetify apply",
        "lint": "npx tsc --noemit && npx eslint src/**",
        "format": "npx prettier --write src/",
        "generate-css": "npx @tailwindcss/cli -i ./src/css/index.css -o ./src/css/tailwind.css --minify"
    },
    "license": "MIT",
    "devDependencies": {
        "@types/pixelmatch": "^5.2.4",
        "dexie": "^4.2.0",
        "dexie-react-hooks": "^4.2.0",
        "lucide-react": "^0.299.0",
        "observable-hooks": "^4.2.3",
        "pixelmatch": "^5.3.0",
        "rxjs": "^7.8.1",
        "spcr-whats-new": "^1.0.1",
        "tailwindcss": "^4.0.4",
        "use-debounce": "^10.0.6",
        "use-fit-text": "^2.4.0"
    }
}
