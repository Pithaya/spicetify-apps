{
    "compilerOptions": {
        "target": "esnext",
        "jsx": "react",
        "module": "esnext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "lib": ["ESNext", "DOM"],
        "paths": {
            "@shared/*": ["./libs/shared/src/*"],
            "custom-apps/*": ["./custom-apps/*"]
        }
    }
}
